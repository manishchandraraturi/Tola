# Copy this file to .env and fill in real values. Never commit .env.

# Database used by Prisma (see prisma/schema.prisma).
# Local/SQLite: file:./db/custom.db
# Production:   postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL="file:./db/custom.db"

# Signs the session cookie in src/lib/auth.ts. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# "1" enables the demo helpers (demo login note, ledger tamper button).
# Set to "0" or leave unset for a real deployment.
NEXT_PUBLIC_DEMO="1"

# Optional: WhatsApp Cloud API notifications (src/lib/notify.ts).
# Without these the app falls back to the DEMO_SMS channel.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Optional: OpenAI-compatible key for the Scribe voice/photo routes.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
